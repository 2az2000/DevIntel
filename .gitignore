# The generated Prisma client — thousands of lines, rebuilt by `pnpm db:generate`.
src/db/generated/

# NOT ignored: src/db/tenant-models.generated.ts
# It is small, it is the list of tables the tenant filter covers, and seeing
# "+ 'NewModel'," appear in a pull request is real security review signal.
# CI also checks it with `git diff --exit-code`, which only works on a tracked
# file — ignoring it would make that check pass vacuously.
